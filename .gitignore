# Dependencies and build output
node_modules/
dist/
build/
coverage/

# Python bytecode caches from the MCP scripts
__pycache__/
*.pyc

# Regenerable local caches: the transformers.js embedding model
# (infra/mcp/.cache, ~130 MB incl. a 115 MB quantized onnx). Re-downloaded by the
# backfill script on first run, so it never belongs in the repo.
.cache/

.DS_Store
*.log

# Secrets. The submitted .env.example is the only env file that may be committed.
.env*
!.env.example

# Credential material
*.pem
*.p12
*service-account*.json
*adminsdk*.json

# Local-only hackathon working docs; not for the public repo.
Dev-Docs/Amazon/
# Third-party credential material, not for the public repo.
Dev-Docs/RevenueCat-Service-Account.md

# The podcast index is a ~400 MB downloaded feed dump (Podcast Index), not a
# source file: it is rebuilt by infra/podcast's ingest script, so it stays local.
infra/podcast/data/*.db

# The long-form guided meditations (~217 MB) are Globie Earth's own published
# assets, served from the site origin (globie.earth/voice/guides/) and linked by
# the skill's live VOICE_BASE_URL. They are not this server's to carry.
infra/mcp/assets/voice/guides/
