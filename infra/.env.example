# Globie Earth MCP — the Alexa+ track submission.
#
# Copy to infra/.env and fill in. infra/.env is git-ignored.
#
# There is very little to set: the server reads every byte of data over the live
# Globie Earth APIs, and the three origins below already point at them, so a
# plain `docker compose up` works with no .env at all.

# --- Origins: where the MCP tools read and write -----------------------------
# The MCP server is deliberately host-agnostic: its only coupling to the rest of
# the stack is these three origins. All three point at the live stack, so the
# tools answer with real data — there is no local seeding and no committed data.
MCP_POSTGREST_URL=https://api.globie.earth   # species, guardians, sites, deeds, DNP
MCP_STUDIO_URL=https://studio.globie.earth   # generate_soundscape
MCP_PODCAST_URL=https://podcast.globie.earth # search_podcasts, get_trending_podcasts

# The DNP species data is not a fourth origin — it is rows inside PostgREST,
# world-readable (the DNP species table narrows the anon grant to `select`),
# so search_forest_knowledge reads the real survey rows through api.globie.earth.

# Both proxies are optional: unset only disables their tools, which then say so
# rather than looking like the whole server is down. If you self-host your own
# studio/podcast, point these at your origins instead.

# --- Host ports (only matter when running compose directly) ------------------
# 8080 is what the MCP container itself listens on; the client's nginx listens
# on 80.
MCP_PORT=8092
MCP_CLIENT_PORT=8082

# --- The demo edge credential (decision D4) ---------------------------------
# A raw MCP client that cannot mint a GoTrue JWT just to try the server sends
# `Authorization: Bearer <MCP_BEARER_TOKEN>`; the server exchanges it, at the MCP
# edge, for MCP_DEMO_DEVICE_ID — never forwarding the token itself onward.
#
# This is a static token, NOT MCP OAuth 2.1, and infra/mcp/README.md states that
# plainly rather than dressing it up: Amazon's Alexa+ account linking (OAuth 2.1
# Authorization Code Grant with PKCE S256) is the production path and is not
# built here. The token is a shared demo secret, bounded to the single demo
# device below, so the two mutating tools (adopt_species, generate_soundscape)
# write only to that device on the live stack.
#
# A device-only client needs neither of these: it sends its own X-Device-Id.
MCP_BEARER_TOKEN=b8478ae4723f41d7f4e14a4fd8ac5f301be3cace3c100be8ce6d218ba75486bc
# Must be a uuid that exists in api.devices. It is also the RevenueCat appUserID,
# exactly like every other device id in this stack, so the RLS policies scope
# the demo caller's reads and writes the same way they scope a
# real device's. Leave both this and MCP_BEARER_TOKEN empty to require callers to
# present their own X-Device-Id header.
MCP_DEMO_DEVICE_ID=00000000-0000-4000-8000-000000000001

# --- Embeddings --------------------------------------------------------------
# How search_forest_knowledge turns text into a vector: `local` (default),
# `bedrock` or `none`. The default runs the self-hosted model in-process
# (Xenova/multilingual-e5-small, 384 dims) and needs no credentials, matching the
# vector(384) embeddings column. `bedrock` uses Titan Text
# Embeddings V1 (1536 dims); `none` is a valid configuration, not a broken one —
# semantic search explains itself and every other tool works.
EMBEDDING_PROVIDER=local

# Bedrock credentials for a service running off AWS, which cannot assume an
# instance role (decision D2). Server-side only, never a VITE_ variable. The SDK
# reads AWS_REGION unless BEDROCK_REGION is set, so setting just one is enough.
# An instance role remains the production path on AWS.
BEDROCK_REGION=
#AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Search rerank (MCP plan §16, decision D6) -------------------------------
# search_forest_knowledge fetches a wider candidate pool, then asks the model to
# reorder it so the passage read aloud first is the one that answers the question.
# It reorders only the rows the database returned — never adds one — and any
# failure (no DEEPSEEK_API_KEY, timeout, malformed reply) keeps the cosine order,
# so it is an enhancement, never a dependency.
#RERANK_ENABLED=true
#RERANK_POOL=20
#RERANK_TIMEOUT_MS=20000
#DEEPSEEK_RERANK_MODEL=

# --- Tool router and vision (POST /route, describe_photo, POST /contribute) ---
# The natural-language tool router and the vision model are one OpenAI-compatible
# chat-completions endpoint. Its key stays server-side by design: the browser
# host is a static bundle, so the model it routes with can never live in the page.
# Unset only makes /route and the vision pass answer a clear 503; the eleven MCP
# tools are unaffected.
#DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# --- Browser origins allowed to call /mcp ------------------------------------
# Comma-separated, matched literally by @fastify/cors like every other CORS list
# in this stack — a bare '*' does NOT work. Only browser MCP clients send an
# Origin; the Alexa+ host and other non-browser clients are unaffected.
#
# The demo client (infra/mcp-client/) is a browser host: whatever origin it is
# served from has to be on this list, or its connect fails as though the server
# were down. 5173 is its local dev origin, 8082 is the compose service below, and
# mcp-client.globie.earth is its live origin — change these if the hostname
# differs. This is the easy one to forget: the OPTIONS preflight can still pass
# while the real POST is blocked, so a missing origin here reads as "server down".
#MCP_CORS_ORIGINS=https://mcp-client.globie.earth,http://localhost:5173,http://localhost:8082

# --- Optional: the self-hosted voice cascade and photo storage ----------------
# Two feature groups ship disabled and fail closed, each in isolation. Neither
# affects the eleven MCP tools, and neither crashes the process — the server
# starts and reports what is unconfigured on GET /health.

# /voice/transcribe and /voice/speak relay to a Speaches instance (STT + TTS).
# That service is not part of this repo and has no public origin, so this stays
# unset and the two routes answer 503. Point it at your own Speaches to turn
# voice on. The server installs whatever models are named here on first use.
#MCP_SPEECH_URL=http://your-speaches:8000
SPEECH_STT_MODEL=Systran/faster-whisper-base
SPEECH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEECH_TTS_VOICE=af_heart

# POST /contribute stores an accepted photograph in an S3-compatible bucket.
# There is no bundled MinIO and no public storage origin, so these are empty and
# the route answers 503. Set MINIO_ENDPOINT (and credentials) to your own store to
# enable it. Credentials are server-side only — never a VITE_ variable.
#MINIO_ENDPOINT=http://your-minio:9000
#MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=globie-media
#MINIO_PUBLIC_URL=
